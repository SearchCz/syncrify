<?xml version="1.0" encoding="UTF-8"?>

<PluginConfig>

    <!-- ===================================================== -->
    <!-- GLOBAL AUTOMATION SETTINGS -->
    <!-- ===================================================== -->
    <!--   -->

    <Field id="gap1" type="label">    
        <Label></Label>
    </Field>


    <Field id="label_describe_syncrify" type="label" 
        alignWithControl="False">
        <Label>Syncrify gives Insteon keypad buttons first class status in Indigo, and keeps them in control and in sync with the device they are meant to control.</Label>
    </Field>

    <Field id="sep0" type="separator" >
    </Field>

    <Field id="label_describe_autobond" type="label" 
        alignWithControl="False">
        <Label>If you like, Syncrify can automatically create these bonds (button-device pairs) for you. Then you just identify the device that coresponds to that button. Sycrify handles the rest</Label>
    </Field>


    <Field id="autoBondEnabled"
        type="checkbox"
        defaultValue="false">
        <Label>Enable Automatic Button-to-Device Bond Creation</Label>
    </Field>

    <Field id="autoBondFolder"
        type="textfield"
        defaultValue="Syncrify"
        visibleBindingId="autoBondEnabled"
        visibleBindingValue="true">
        <Label>Target Folder for Bond Devices:</Label>
    </Field>

    <Field id="sep2" type="separator" >
    </Field>

    <Field id="active"
        type="checkbox"
        defaultValue="true">
        <Label>Syncrify Active</Label>
    </Field>

    <Field id="debug"
        type="checkbox"
        defaultValue="false">
        <Label>Enable Debug Logging</Label>
    </Field>

    <Field id="gap2" type="label">    
        <Label></Label>
    </Field>
    <Field id="gap3" type="label">    
        <Label></Label>
    </Field>
    <Field id="gap4" type="label">    
        <Label></Label>
    </Field>
    <Field id="gap5" type="label">    
        <Label></Label>
    </Field>



</PluginConfig>